# Copy to .env and adjust. In production set these as real environment variables.
APP_ENV=development

# SQLAlchemy URL (psycopg 3 driver). Matches the "db" service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# Used only by pytest. Matches the "db_test" service in docker-compose.yml.
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins (Angular dev server by default).
CORS_ORIGINS=http://localhost:4200

# Used by `uv run app-cli create-admin` when no arguments are given.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-please
